#!/usr/bin/env bash
# ==============================================================================
# f(x) Studio — Interactive Video Render Wizard
# ==============================================================================
set -e

# Determine repository root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Ensure output directory exists inside agentic motion design toolset
mkdir -p "$SCRIPT_DIR/out"

# Detect Bun binary across platforms (Git Bash, WSL, native Windows)
BUN="bun"
if ! command -v "$BUN" &>/dev/null; then
  if command -v bun.exe &>/dev/null; then
    BUN="bun.exe"
  elif [ -f "$HOME/.bun/bin/bun" ]; then
    BUN="$HOME/.bun/bin/bun"
  elif [ -f "$LOCALAPPDATA/Microsoft/WinGet/Links/bun.exe" ]; then
    BUN="$LOCALAPPDATA/Microsoft/WinGet/Links/bun.exe"
  elif [ -f "/mnt/c/Users/brosf/AppData/Local/Microsoft/WinGet/Packages/Oven-sh.Bun_Microsoft.Winget.Source_8wekyb3d8bbwe/bun-windows-x64/bun.exe" ]; then
    BUN="/mnt/c/Users/brosf/AppData/Local/Microsoft/WinGet/Packages/Oven-sh.Bun_Microsoft.Winget.Source_8wekyb3d8bbwe/bun-windows-x64/bun.exe"
  else
    echo -e "\033[1;31m[Error] bun runtime not found in PATH.\033[0m"
    echo "Please ensure Bun is installed and available in your environment."
    exit 1
  fi
fi

# If arguments are passed directly, pass through to render.ts without prompting
if [ $# -gt 0 ]; then
  exec "$BUN" scripts/render.ts video "$@"
fi

# ANSI Colors
BOLD="\033[1m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
DIM="\033[2m"
RESET="\033[0m"

echo -e "\n${CYAN}╔════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║             f(x) Studio — Video Render Wizard              ║${RESET}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${RESET}"
echo -e "${DIM}Destination folder:${RESET} ${SCRIPT_DIR}/out\n"

# 1. Discover available projects with a project.json
PROJECTS=()
for d in app/src/scenes/*; do
  if [ -d "$d" ] && [ -f "$d/project.json" ]; then
    PROJECTS+=("$(basename "$d")")
  fi
done

if [ ${#PROJECTS[@]} -eq 0 ]; then
  echo -e "${RED}[Error] No projects found in app/src/scenes with project.json${RESET}"
  exit 1
fi

# Detect active project as default
DEFAULT_PROJECT="bird_odyssey"
if [ -f "app/src/scenes/active.json" ]; then
  ACTIVE_CANDIDATE=$("$BUN" -e "try { console.log(require('./app/src/scenes/active.json').project || ''); } catch { console.log(''); }" < /dev/null 2>/dev/null || true)
  if [ -n "$ACTIVE_CANDIDATE" ] && [ -d "app/src/scenes/$ACTIVE_CANDIDATE" ]; then
    DEFAULT_PROJECT="$ACTIVE_CANDIDATE"
  fi
fi

echo -e "${BOLD}Available Projects:${RESET}"
for i in "${!PROJECTS[@]}"; do
  idx=$((i + 1))
  p="${PROJECTS[$i]}"
  if [ "$p" = "$DEFAULT_PROJECT" ]; then
    printf "  ${GREEN}%2d) %-24s (active/default)${RESET}\n" "$idx" "$p"
  else
    printf "  ${DIM}%2d)${RESET} %-24s\n" "$idx" "$p"
  fi
done
echo ""

# Prompt project
read -r -p "$(echo -e "${BOLD}Select project${RESET} [1-${#PROJECTS[@]} or name] ${GREEN}[default: $DEFAULT_PROJECT]${RESET}: ")" CHOSEN_PROJECT || true
CHOSEN_PROJECT="${CHOSEN_PROJECT:-$DEFAULT_PROJECT}"

# Check if input was a number
if [[ "$CHOSEN_PROJECT" =~ ^[0-9]+$ ]] && [ "$CHOSEN_PROJECT" -ge 1 ] && [ "$CHOSEN_PROJECT" -le "${#PROJECTS[@]}" ]; then
  PROJECT="${PROJECTS[$((CHOSEN_PROJECT - 1))]}"
else
  PROJECT="$CHOSEN_PROJECT"
fi

if [ ! -f "app/src/scenes/$PROJECT/project.json" ]; then
  echo -e "${RED}[Error] Project '$PROJECT' not found at app/src/scenes/$PROJECT/project.json${RESET}"
  exit 1
fi

echo -e "Selected: ${CYAN}${PROJECT}${RESET}\n"

# 2. Extract project duration (< /dev/null ensures stdin isn't consumed by bun)
DURATION=$("$BUN" -e "
  try {
    const p = require('./app/src/scenes/' + process.argv[1] + '/project.json');
    const ends = (p.entries || []).map(e => Number(e.end) || 0);
    const max = Math.max(...ends, 0);
    console.log(max > 0 ? max : '10');
  } catch (e) {
    console.log('10');
  }
" "$PROJECT" < /dev/null 2>/dev/null || echo "10")

# 3. Time range
read -r -p "$(echo -e "${BOLD}Start time (seconds)${RESET} ${GREEN}[default: 0]${RESET}: ")" INPUT_FROM || true
FROM="${INPUT_FROM:-0}"

read -r -p "$(echo -e "${BOLD}End time (seconds)${RESET} ${GREEN}[default: $DURATION (full)]${RESET}: ")" INPUT_TO || true
TO="${INPUT_TO:-$DURATION}"

# 4. Sampling (Motion Blur / AA)
echo -e "\n${BOLD}Sampling (sub-frames per frame for motion blur & temporal AA):${RESET}"
echo -e "  ${GREEN}8${RESET}    - High quality (${BOLD}Recommended${RESET}: smooth motion blur, fast)"
echo -e "  ${DIM}1${RESET}    - Preview (sharp, no motion blur, fastest)"
echo -e "  ${DIM}16${RESET}   - Cinematic (ultra-smooth motion blur)"
echo -e "  ${YELLOW}auto${RESET} - Adaptive tolerance (can be slow on complex 3D scenes)"
read -r -p "$(echo -e "${BOLD}Samples${RESET} [8 / 1 / 16 / auto, or number] ${GREEN}[default: 8]${RESET}: ")" INPUT_SAMPLES || true
SAMPLES="${INPUT_SAMPLES:-8}"

# 5. Frame rate (FPS)
read -r -p "$(echo -e "\n${BOLD}Frame rate (FPS)${RESET} [24 / 30 / 60] ${GREEN}[default: 60]${RESET}: ")" INPUT_FPS || true
FPS="${INPUT_FPS:-60}"

# 6. GPU Acceleration
read -r -p "$(echo -e "\n${BOLD}Enable GPU hardware encoding (AMD AMF / NVENC)?${RESET} [Y/n] ${GREEN}[default: Y]${RESET}: ")" INPUT_GPU || true
INPUT_GPU="${INPUT_GPU:-Y}"
GPU_FLAG=""
if [[ "$INPUT_GPU" =~ ^[Yy]$ ]]; then
  GPU_FLAG="--gpu"
fi

# 7. Orientation & Resolution
IS_VERTICAL_DEFAULT="false"
IS_VERT_DETECTED=$("$BUN" -e "
  try {
    const p = require('./app/src/scenes/' + process.argv[1] + '/project.json');
    if (p.size && Array.isArray(p.size) && p.size.length >= 2 && Number(p.size[1]) > Number(p.size[0])) {
      console.log('true');
    } else {
      console.log('false');
    }
  } catch (e) {
    console.log('false');
  }
" "$PROJECT" < /dev/null 2>/dev/null || echo "false")

echo -e "\n${BOLD}Orientation:${RESET}"
if [ "$IS_VERT_DETECTED" = "true" ]; then
  echo -e "  ${CYAN}Detected: Vertical 9:16 (Shorts / Reels / TikTok: 1080x1920)${RESET}"
  echo -e "  ${GREEN}1)${RESET} Vertical 9:16 (Shorts / Reels / TikTok) ${GREEN}[Default]${RESET}"
  echo -e "  ${DIM}2)${RESET} Horizontal 16:9 (Landscape)"
  read -r -p "$(echo -e "\n${BOLD}Select orientation${RESET} [1 = Vertical, 2 = Horizontal] ${GREEN}[default: 1]${RESET}: ")" INPUT_ORIENT || true
  if [ "$INPUT_ORIENT" = "2" ]; then
    IS_VERTICAL="false"
  else
    IS_VERTICAL="true"
  fi
else
  echo -e "  ${CYAN}Detected: Horizontal 16:9 (Landscape: 1920x1080)${RESET}"
  echo -e "  ${GREEN}1)${RESET} Horizontal 16:9 (Landscape) ${GREEN}[Default]${RESET}"
  echo -e "  ${DIM}2)${RESET} Vertical 9:16 (Shorts / Reels / TikTok)"
  read -r -p "$(echo -e "\n${BOLD}Select orientation${RESET} [1 = Horizontal, 2 = Vertical] ${GREEN}[default: 1]${RESET}: ")" INPUT_ORIENT || true
  if [ "$INPUT_ORIENT" = "2" ]; then
    IS_VERTICAL="true"
  else
    IS_VERTICAL="false"
  fi
fi

echo -e "\n${BOLD}Resolution:${RESET}"
if [ "$IS_VERTICAL" = "true" ]; then
  echo -e "  ${DIM}1)${RESET} 720p  - Fast Preview / Draft (720x1280) [Fastest]"
  echo -e "  ${GREEN}2)${RESET} 1080p - Standard Full HD (1080x1920) ${GREEN}[Recommended / Default]${RESET}"
  echo -e "  ${DIM}3)${RESET} 4K    - Ultra HD (2160x3840) [High Quality]"
else
  echo -e "  ${DIM}1)${RESET} 720p  - Fast Preview / Draft (1280x720) [Fastest]"
  echo -e "  ${GREEN}2)${RESET} 1080p - Standard Full HD (1920x1080) ${GREEN}[Recommended / Default]${RESET}"
  echo -e "  ${DIM}3)${RESET} 4K    - Ultra HD (3840x2160) [High Quality]"
fi

read -r -p "$(echo -e "\n${BOLD}Select resolution${RESET} [1 = 720p, 2 = 1080p, 3 = 4K] ${GREEN}[default: 2]${RESET}: ")" INPUT_RES || true
INPUT_RES="${INPUT_RES:-2}"

RES_ARGS=()
if [ "$INPUT_RES" = "1" ] || [[ "$INPUT_RES" == *"720"* ]]; then
  RES_LABEL="720p"
  if [ "$IS_VERTICAL" = "true" ]; then
    RES_ARGS=("--720p" "--vertical")
    RES_DIMS="720x1280 (vertical 9:16)"
  else
    RES_ARGS=("--720p" "--horizontal")
    RES_DIMS="1280x720 (16:9)"
  fi
elif [ "$INPUT_RES" = "3" ] || [[ "$INPUT_RES" == *"4k"* ]] || [[ "$INPUT_RES" == *"4K"* ]]; then
  RES_LABEL="4K Ultra HD"
  if [ "$IS_VERTICAL" = "true" ]; then
    RES_ARGS=("--4k" "--vertical")
    RES_DIMS="2160x3840 (vertical 9:16)"
  else
    RES_ARGS=("--4k" "--horizontal")
    RES_DIMS="3840x2160 (16:9)"
  fi
else
  RES_LABEL="1080p Full HD"
  if [ "$IS_VERTICAL" = "true" ]; then
    RES_ARGS=("--1080p" "--vertical")
    RES_DIMS="1080x1920 (vertical 9:16)"
  else
    RES_ARGS=("--1080p" "--horizontal")
    RES_DIMS="1920x1080 (16:9)"
  fi
fi

# 8. Output Filename
DEFAULT_OUT="${PROJECT}.mp4"
if [ "$TO" != "$DURATION" ] || [ "$FROM" != "0" ]; then
  DEFAULT_OUT="${PROJECT}_${FROM}s_${TO}s.mp4"
fi

echo -e "\n${BOLD}Output file destination:${RESET} ${SCRIPT_DIR}/out/"
read -r -p "$(echo -e "${BOLD}Output filename${RESET} ${GREEN}[default: $DEFAULT_OUT]${RESET}: ")" INPUT_OUT || true
OUT_FILE="${INPUT_OUT:-$DEFAULT_OUT}"
# Ensure .mp4 extension if none specified
if [[ "$OUT_FILE" != *.* ]]; then
  OUT_FILE="${OUT_FILE}.mp4"
fi

# Relative out path for render.ts (it resolves against ROOT/out)
REL_OUT="out/${OUT_FILE}"
ABS_OUT="${SCRIPT_DIR}/out/${OUT_FILE}"

# 9. Summary & Confirmation (< /dev/null ensures stdin isn't drained)
TOTAL_TIME=$("$BUN" -e "console.log((${TO} - ${FROM}).toFixed(2))" < /dev/null 2>/dev/null || echo "$((TO - FROM))")
TOTAL_FRAMES=$("$BUN" -e "console.log(Math.round((${TO} - ${FROM}) * ${FPS}))" < /dev/null 2>/dev/null || echo "0")

echo -e "\n${CYAN}────────────────────────────────────────────────────────────${RESET}"
echo -e "${BOLD}Render Configuration Summary:${RESET}"
echo -e "${CYAN}────────────────────────────────────────────────────────────${RESET}"
echo -e "  • Project:      ${GREEN}${PROJECT}${RESET}"
echo -e "  • Orientation:  $(if [ "$IS_VERTICAL" = "true" ]; then echo -e "${CYAN}Vertical 9:16 (Shorts / Reels / TikTok)${RESET}"; else echo -e "${CYAN}Horizontal 16:9 (Landscape)${RESET}"; fi)"
echo -e "  • Resolution:   ${GREEN}${RES_LABEL}${RESET} (${RES_DIMS})"
echo -e "  • Time Window:  ${YELLOW}${FROM}s${RESET} → ${YELLOW}${TO}s${RESET} (${BOLD}${TOTAL_TIME}s${RESET} duration / ${BOLD}${TOTAL_FRAMES}${RESET} frames)"
echo -e "  • Sampling:     ${GREEN}${SAMPLES}${RESET}"
echo -e "  • Frame Rate:   ${GREEN}${FPS} fps${RESET}"
echo -e "  • GPU Encode:   ${GREEN}${GPU_FLAG:-disabled}${RESET}"
echo -e "  • Output Path:  ${CYAN}${SCRIPT_DIR}/${REL_OUT}${RESET}"
echo -e "${CYAN}────────────────────────────────────────────────────────────${RESET}"

CMD=("$BUN" "scripts/render.ts" "video" "--project" "$PROJECT" "--from" "$FROM" "--to" "$TO" "--fps" "$FPS" "--samples" "$SAMPLES" "${RES_ARGS[@]}" "--out" "$REL_OUT")
if [ -n "$GPU_FLAG" ]; then
  CMD+=("$GPU_FLAG")
fi

echo -e "${BOLD}Executing command:${RESET}"
echo -e "  ${DIM}${CMD[*]}${RESET}\n"

read -r -p "$(echo -e "${BOLD}Start render now?${RESET} [Y/n] ${GREEN}[default: Y]${RESET}: ")" CONFIRM || true
CONFIRM="${CONFIRM:-Y}"
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
  echo -e "\n${YELLOW}Render aborted by user.${RESET}"
  exit 0
fi

echo -e "\n${GREEN}[render] Starting render pipeline...${RESET}\n"
START_TIME=$(date +%s)

"${CMD[@]}"

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo -e "\n${CYAN}════════════════════════════════════════════════════════════${RESET}"
if [ -f "$ABS_OUT" ]; then
  FILE_SIZE=$(du -h "$ABS_OUT" 2>/dev/null | cut -f1 || ls -lh "$ABS_OUT" 2>/dev/null | awk '{print $5}' || echo "created")
  echo -e "${GREEN}${BOLD}✔ Render Complete in ${ELAPSED}s!${RESET}"
  echo -e "  Output file: ${BOLD}${ABS_OUT}${RESET} (${FILE_SIZE})"
else
  echo -e "${GREEN}${BOLD}✔ Render process finished in ${ELAPSED}s!${RESET}"
  echo -e "  Output path: ${BOLD}${REL_OUT}${RESET}"
fi
echo -e "${CYAN}════════════════════════════════════════════════════════════${RESET}\n"
